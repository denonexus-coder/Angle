# Configuração para Android ARM64 (API Level 26+)

# Importar configuração base do ANGLE
import("//gni/angle.gni")

# ===== CONFIGURAÇÕES DE BUILD =====
# Habilitar build ESTÁTICO
angle_static_linking = true
angle_use_static_angle = true
is_component_build = false  # ⚠️ CRÍTICO: Desabilita component build

# Forçar bibliotecas estáticas (não compartilhadas)
angle_enable_shared_egl = false
angle_enable_shared_glesv2 = false

# ===== EXPORTAR SÍMBOLOS PARA LTW =====
angle_export_egl_symbols = true
angle_export_gles_symbols = true
angle_ltw_compatibility = true

# ===== BACKENDS =====
# Apenas Vulkan (desabilitar outros para reduzir tamanho)
angle_enable_vulkan = true
angle_enable_gl = false
angle_enable_d3d11 = false
angle_enable_metal = false
angle_enable_null = false
angle_enable_wgpu = false
angle_enable_swiftshader = false
angle_enable_cl = false
angle_enable_cl_passthrough = false

# ===== PLATAFORMA =====
# Android ARM64
target_os = "android"
target_cpu = "arm64"
android_ndk_api_level = 26

# ===== OTIMIZAÇÕES =====
# Build de release
is_debug = false
is_official_build = true

# Otimização para tamanho
angle_enable_global_mutex_load_time_allocate = true
angle_enable_global_mutex_recursion = false

# Desabilitar features desnecessários
angle_enable_trace = false
angle_enable_trace_android_logcat = false
angle_enable_trace_events = false
angle_enable_debug_layers = false
angle_enable_perf_counter_output = false
angle_enable_unwind_backtrace_support = false
angle_enable_memory_alloc_logging = false
angle_build_tests = false
angle_build_all = false
